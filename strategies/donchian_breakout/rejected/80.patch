 """Donchian channel breakout (Turtle Traders, Richard Dennis 1983), long-only:
 enter when close breaks above the highest high of the previous `entry_n` days,
-exit when close falls below the lowest low of the previous `exit_n` days."""
+exit when close falls below the lowest low of the previous `exit_n` days.
+
+Position sizing (Turtle "N" units): at entry, size the position so that a move
+of `atr_mult` x ATR(`atr_n`) costs `risk` of the asset's 1/N sleeve:
+    sleeve fraction = min(1, risk / (atr_mult * ATR / close))
+The size is fixed for the life of the trade (like the Turtles' units), so the
+position is not resized daily."""
+import numpy as np
 import pandas as pd
 
-from src.backtest.helpers import equal_weight, frame, hold_until
+from src.backtest.helpers import equal_weight, frame
 
 
 def valid(p):
     return p["exit_n"] < p["entry_n"]
 
 
+def atr(b: pd.DataFrame, n: int) -> pd.Series:
+    prev = b["close"].shift(1)
+    tr = pd.concat([b["high"] - b["low"], (b["high"] - prev).abs(), (b["low"] - prev).abs()], axis=1).max(axis=1)
+    return tr.ewm(alpha=1 / n, adjust=False).mean()  # Wilder smoothing
+
+
 def positions(bars, p):
     c = frame(bars)
     sig = {}
     for s, b in bars.items():
-        upper = b["high"].rolling(p["entry_n"]).max().shift(1)
-        lower = b["low"].rolling(p["exit_n"]).min().shift(1)
-        sig[s] = hold_until(b["close"] > upper, b["close"] < lower)
+        upper = b["high"].rolling(p["entry_n"]).max().shift(1).to_numpy()
+        lower = b["low"].rolling(p["exit_n"]).min().shift(1).to_numpy()
+        close = b["close"].to_numpy()
+        size = np.minimum(1.0, p["risk"] / (p["atr_mult"] * atr(b, p["atr_n"]) / b["close"])).to_numpy()
+        pos, out = 0.0, np.zeros(len(b))
+        for i in range(len(b)):
+            if pos and close[i] < lower[i]:
+                pos = 0.0
+            elif not pos and close[i] > upper[i] and size[i] == size[i]:
+                pos = size[i]
+            out[i] = pos
+        sig[s] = pd.Series(out, index=b.index)
     return equal_weight(pd.DataFrame(sig).reindex(c.index), c)
